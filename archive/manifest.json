    "key": "created_at month",
    "mutable": true,
    "meaning": "the current asOf state of rows created in that month"
  },
  "tables": 18,
  "rows": 133564,
  "bytes": 73794656,
  "excluded": {
    "User": "email + hashed_password — a real person's login",
    "ApiKey": "key_hash — a credential, even hashed",
    "chain_key": "private_key — the offices' signing material",
    "agent_wallet": "private_key + address + agentbook_human_id",
    "house_alias": "retained raw credential subject — private historical deduplication material; action/protocol subjects may differ and row presence grants no authority",
    "nudge": "identity holds RAW credentials in all 3 prod rows (checked 2026-08-20), not the hashed keyspaces the code now writes",
    "gallery_vote": "identity is hashed today, but five legacy rows carried a wallet address and the keeper key; the table is human-keyed and buys nothing here",
