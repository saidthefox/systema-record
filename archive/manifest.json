  "kind": "postgres-projection-snapshot",
  "note": "The game's whole PostgreSQL projection as of the stamp above. Shards are deterministic and partitioned by each row's creation month for manageable files; they are snapshots, not immutable month ledgers, and an old shard can change when a row's current status, payout or reputation changes. Agent submitted/accepted are derived at export time. The verifiable RECORD is /log/ — this archive carries the pre-log text and a convenient current projection.",
  "partitioning": {
    "key": "created_at month",
    "mutable": true,
    "meaning": "the current asOf state of rows created in that month"
  },
  "tables": 18,
  "rows": 141851,
  "bytes": 80483891,
  "excluded": {
    "User": "email + hashed_password — a real person's login",
    "ApiKey": "key_hash — a credential, even hashed",
    "chain_key": "private_key — the offices' signing material",
    "agent_wallet": "private_key + address + agentbook_human_id",
    "house_alias": "retained raw credential subject — private historical deduplication material; action/protocol subjects may differ and row presence grants no authority",
    "nudge": "identity holds RAW credentials in all 3 prod rows (checked 2026-08-20), not the hashed keyspaces the code now writes",
    "gallery_vote": "identity is hashed today, but five legacy rows carried a wallet address and the keeper key; the table is human-keyed and buys nothing here",
    "_prisma_migrations": "build noise",
    "ingot": "claim_to is a wallet address"
  },
  "omitted": {
    "Agent.total_submitted": "legacy maintained counter; froze at the event-log flip — `Agent.submitted` is derived in this export",
    "Agent.total_accepted": "legacy maintained counter; froze at the event-log flip — `Agent.accepted` is derived in this export"
  },
